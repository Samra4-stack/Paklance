datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Availability {
  AVAILABLE
  BUSY
  NOT_AVAILABLE
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
    name          String?
passwordHash  String
  role          Role
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verification  Verification?
  jobs          Job[]
  contractsAsClient Contract[] @relation("ClientContracts")
  contractsAsSpecialist Contract[] @relation("SpecialistContracts")
  escrows       Escrow[] @relation("UserEscrows")
  disputesRaised Dispute[] @relation("UserDisputes")
  wallets       Wallet[]  // added for wallet relation

  // Profile fields
  bio          String?
  headline     String?
  skills       String[]
  hourlyRate   Decimal?
  availability Availability @default(AVAILABLE)
  country      String?
  city         String?
  avatarUrl    String?

  // Relation to portfolio items
  portfolioItems PortfolioItem[]
}

enum Role {
  ADMIN
  CLIENT
  SPECIALIST
}

model Verification {
  id            String   @id @default(uuid())
  userId        String   @unique
  documentUrl   String
  status        VerificationStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User @relation(fields: [userId], references: [id])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Job {
  id            String   @id @default(uuid())
  title         String
  description   String
  budget        Decimal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clientId      String

  client        User @relation(fields: [clientId], references: [id])
  contracts     Contract[]
}

model Contract {
  id            String   @id @default(uuid())
  jobId         String
  clientId      String
  specialistId  String
  status        ContractStatus @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  job           Job @relation(fields: [jobId], references: [id])
  client        User @relation("ClientContracts", fields: [clientId], references: [id])
  specialist    User @relation("SpecialistContracts", fields: [specialistId], references: [id])
  milestones    Milestone[]
  escrow        Escrow?
  disputes      Dispute[]
}

enum ContractStatus {
  DRAFT
  FUNDED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CLOSED
}

model Milestone {
  id            String   @id @default(uuid())
  contractId    String
  title         String
  description   String
  amount        Decimal
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contract      Contract @relation(fields: [contractId], references: [id])
}

enum MilestoneStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

model Escrow {
  id                String   @id @default(uuid())
  contractId        String   @unique
  balance           Decimal @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId        String
  user          User @relation("UserEscrows", fields: [userId], references: [id])
  contract         Contract @relation(fields: [contractId], references: [id])
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id               String   @id @default(uuid())
  escrowId         String
  sourceWalletId   String
  destinationWalletId String
  amount           Decimal
  status           LedgerStatus @default(PENDING)
  createdAt        DateTime @default(now())

  escrow           Escrow @relation(fields: [escrowId], references: [id])
}

enum LedgerStatus {
  PENDING
  COMPLETED
  FAILED
}

model Dispute {
  id               String   @id @default(uuid())
  contractId       String
  raisedByUserId   String
  reason           String
  status           DisputeStatus @default(OPEN)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contract         Contract @relation(fields: [contractId], references: [id])
  raisedByUser     User @relation("UserDisputes", fields: [raisedByUserId], references: [id])
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  amount      Decimal
  type        String   // e.g., "DEPOSIT", "WITHDRAWAL"
  createdAt   DateTime @default(now())

  wallet      Wallet @relation(fields: [walletId], references: [id])
}

model PortfolioItem {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  imageUrl    String?
  projectUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id])
}


