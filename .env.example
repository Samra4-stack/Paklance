# Paklance Backend — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env (or any file with real secrets) to version control.
#
# Required for ALL environments:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Optional — set a specific port (defaults to 3000 if unset)
PORT=3000

# Optional — CORS origin for production (defaults to * in dev)
CORS_ORIGIN="https://your-frontend-domain.vercel.app"

# --- Seed script (not loaded automatically) ---
# Used only when running: npx ts-node prisma/seed.ts
# ADMIN_EMAIL="admin@yourplatform.com"
# ADMIN_PASSWORD="AtLeast8Characters!"

# --- How to generate a strong JWT_SECRET ---
# PowerShell: -join ((1..32) | ForEach-Object { '{0:X2}' -f (Get-Random -Max 256) })
# Unix/macOS: openssl rand -hex 32
